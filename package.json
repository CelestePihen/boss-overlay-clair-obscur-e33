{
  "name": "boss-overlay",
  "version": "1.2.1",
  "author": {
    "name": "Cel___",
    "email": "pihenceleste@gmail.com"
  },
  "description": "Boss Checklist Overlay for Clair Obscur Expedition 33",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:ci": "tsc && vite build && electron-builder --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "generate:pictos": "node --experimental-strip-types tools/generatePictosCatalog.mjs",
    "test:save-parser": "node --experimental-strip-types test/saveParserPictos.test.ts",
    "fill:pictos-acquire": "python tools/fill_missing_pictos_acquire.py",
    "validate:pictos-acquire": "node tools/validatePictosAcquire.mjs",
    "ts:check": "tsc --noEmit",
    "prepare": "husky",
    "test:checklist-model": "node --experimental-strip-types test/checklistModel.test.ts",
    "test:background-opacity": "node --experimental-strip-types test/backgroundOpacity.test.ts",
    "test:current-location": "node --experimental-strip-types test/currentLocation.test.ts",
    "generate:monoco-feet": "node --experimental-strip-types tools/generateMonocoFeetCatalog.ts",
    "test:monoco-feet-catalog": "node --experimental-strip-types test/monocoFeetCatalog.test.ts",
    "test:monoco-feet-parser": "node --experimental-strip-types test/monocoFeetParser.test.ts",
    "test:window-state": "node --experimental-strip-types test/windowState.test.ts",
    "test:zone-levels": "node --experimental-strip-types test/zoneLevels.test.ts",
    "test:zone-level-label": "node --experimental-strip-types test/zoneLevelLabel.test.ts",
    "test:journal-locations": "node --experimental-strip-types test/journalLocations.test.ts",
    "test:journal-parser": "node --experimental-strip-types test/journalParser.test.ts",
    "test:lost-gestrals-catalog": "node --experimental-strip-types test/lostGestralsCatalog.test.ts",
    "test:lost-gestrals-parser": "node --experimental-strip-types test/lostGestralsParser.test.ts",
    "test:friendly-nevrons-catalog": "node --experimental-strip-types test/friendlyNevronsCatalog.test.ts",
    "test:friendly-nevrons-parser": "node --experimental-strip-types test/friendlyNevronsParser.test.ts",
    "test:weapon-locations": "node --experimental-strip-types test/weaponLocations.test.ts",
    "test:weapon-catalog": "node --experimental-strip-types test/weaponCatalog.test.ts",
    "test:weapon-parser": "node --experimental-strip-types test/weaponParser.test.ts",
    "test:checklist-visibility": "node --experimental-strip-types test/checklistVisibility.test.ts",
    "test:music-locations": "node --experimental-strip-types test/musicLocations.test.ts",
    "test:music-catalog": "node --experimental-strip-types test/musicCatalog.test.ts",
    "test:music-parser": "node --experimental-strip-types test/musicParser.test.ts",
    "test:ci": "npm run test:save-parser && npm run test:checklist-model && npm run test:background-opacity && npm run test:current-location && npm run test:monoco-feet-catalog && npm run test:monoco-feet-parser && npm run test:window-state && npm run test:zone-levels && npm run test:zone-level-label && npm run test:journal-locations && npm run test:journal-parser && npm run test:lost-gestrals-catalog && npm run test:lost-gestrals-parser && npm run test:friendly-nevrons-catalog && npm run test:friendly-nevrons-parser && npm run test:weapon-locations && npm run test:weapon-catalog && npm run test:weapon-parser && npm run test:checklist-visibility && npm run test:music-locations && npm run test:music-catalog && npm run test:music-parser"
  },
  "license": "CC-BY-NC-SA-4.0",
  "dependencies": {
    "chokidar": "5.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@eslint/js": "10.0.1",
    "@types/node": "25.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "40.7.0",
    "electron-builder": "26.8.1",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "7.3.1",
    "vite-plugin-electron": "0.29.0",
    "vite-plugin-electron-renderer": "0.14.6"
  }
}
